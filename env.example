# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Sign-In (via Supabase Auth) ---
# Configure the Google provider inside Supabase Auth settings.
# No extra client secret is needed here — Supabase handles the OAuth exchange.

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxx

# --- Brevo (transactional/marketing email) ---
# lib/email.js no-ops with a console log if this isn't set, safe to skip
# for local development.
BREVO_API_KEY=your-brevo-api-key

# --- App ---
NEXT_PUBLIC_SITE_URL=https://commission.ng
NEXT_PUBLIC_BRAND_COLOR=#FFCB05

# --- Commission Platform Fee ---
# Percentage of the AFFILIATE COMMISSION (not the sale) that Commission retains.
PLATFORM_FEE_PERCENT=15

# --- Payout batching cron (app/api/payouts/run) ---
# Any long random string. Vercel Cron sends this automatically as a Bearer
# token if you add it under Project Settings -> Cron Jobs, or set it in the
# Authorization header of whatever scheduler you use.
CRON_SECRET=replace-with-a-long-random-string

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Commission <notifications@commission.ng>"

# --- On-demand ISR revalidation (app/api/revalidate) ---
REVALIDATE_SECRET=replace-with-a-long-random-string

# --- SMS/OTP provider selection ---
# "termii" or "sendchamp" - default is sendchamp, since Termii's account
# is currently stuck on "Country Inactive" with no clear timeline, while
# Sendchamp's sender IDs already show Approved. Switching back once
# Termii clears is just changing this one value, no code changes.
SMS_PROVIDER=sendchamp

# --- Sendchamp (SMS OTP) ---
SENDCHAMP_API_KEY=your-sendchamp-api-key
SENDCHAMP_SENDER_ID=SC-OTP

TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=Commission

# --- Temporary: disables the phone-verification dashboard gate ---
# Set to "true" while Termii's account is pending country/DND activation.
# Remove this line (or set to anything else) to re-enable the gate.
DISABLE_PHONE_VERIFICATION_GATE=true

# --- Temporary: disables Radar's inline OTP on the Interest Form ---
# Same reason as above - every lead is treated as coming from a Trusted
# affiliate while this is set, skipping OTP so the rest of the lead flow
# can still be tested. Remove once Termii confirms activation.
DISABLE_RADAR_OTP=true
