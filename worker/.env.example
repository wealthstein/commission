# Supabase (service role - this process writes inbox_* rows on behalf of any business)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Must match INBOX_WORKER_INTERNAL_TOKEN in the main app's env
INBOX_WORKER_INTERNAL_TOKEN=change-me-shared-secret

# Where Baileys auth sessions are persisted on disk. Mount a persistent
# volume at this path in production (Fly.io/Railway volumes) - losing this
# directory means every connected number has to re-scan its QR code.
AUTH_STORAGE_DIR=/data/sessions

# Push notifications - inert (no-op) until the main app registers a service
# worker to actually collect subscriptions. Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

PORT=8080
